<?xml version="1.0" encoding="UTF-8"?>
<launch4jConfig>
  <dontWrapJar>false</dontWrapJar>
  <headerType>gui</headerType>
  <outfile>../../../dist/app/BookTech.exe</outfile>
  <jar>../../../dist/app/BookTech.jar</jar>
  <errTitle>BookTech</errTitle>
  <chdir>.</chdir>
  <priority>normal</priority>
  <downloadUrl>https://adoptium.net/</downloadUrl>
  <supportUrl>https://adoptium.net/</supportUrl>
  <stayAlive>false</stayAlive>
  <restartOnCrash>false</restartOnCrash>
  <manifest></manifest>
  <icon>../../../src/main/resources/images/iconApp.ico</icon>
  <classPath>
    <mainClass>application.Bootstrap</mainClass>
    <cp>BookTech.jar</cp>
    <cp>lib/*</cp>
  </classPath>
  <singleInstance>
    <mutexName>BookTechSingleInstance</mutexName>
    <windowTitle>BookTech</windowTitle>
  </singleInstance>
  <jre>
    <path>runtime</path>
    <bundledJre64Bit>true</bundledJre64Bit>
    <runtimeBits>64/32</runtimeBits>
    <minVersion>21</minVersion>
  </jre>
</launch4jConfig>






