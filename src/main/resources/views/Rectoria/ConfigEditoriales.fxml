<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<HBox spacing="20.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.Rectoria.ConfigEditorialesController">
    <VBox spacing="10.0" HBox.hgrow="ALWAYS">
        <Label styleClass="subtitulo" text="Lista de Editoriales" />
        <TextField fx:id="txtBuscarEditorial" promptText="Buscar editorial..." styleClass="combo-filtro" />
        <TableView fx:id="tblEditoriales" minHeight="320.0" styleClass="tabla-datos" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colEditorialId" prefWidth="60.0" text="ID" />
                <TableColumn fx:id="colEditorialNombre" prefWidth="250.0" text="Nombre" />
                <TableColumn fx:id="colEditorialEstado" prefWidth="100.0" text="Estado" />
            </columns>
            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
        </TableView>
    </VBox>
    <VBox spacing="15.0" styleClass="panel-formulario" HBox.hgrow="NEVER" prefWidth="350.0">
        <VBox spacing="5.0">
            <Label styleClass="subtitulo" text="Detalles de Editorial" />
            <Label fx:id="lblEstadoEdicionEditorial" styleClass="descripcion-seccion" text="Seleccione una editorial para editar o limpie para crear." wrapText="true" />
        </VBox>
        <TextField fx:id="txtEditorialNombre" promptText="Nombre de la Editorial" styleClass="input-text" />
        <ComboBox fx:id="cbEditorialEstado" maxWidth="Infinity" promptText="Estado" styleClass="combo-filtro" />
        <HBox spacing="10.0" alignment="CENTER_RIGHT">
            <Button mnemonicParsing="false" onAction="#limpiarFormularioEditorial" styleClass="btn-secundario" text="Limpiar" />
            <Button mnemonicParsing="false" onAction="#guardarEditorial" styleClass="btn-principal" text="Guardar" />
        </HBox>
    </VBox>
</HBox>