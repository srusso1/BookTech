<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox spacing="12.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.Rectoria.ConfigEstudiantesController">
    <padding>
        <Insets bottom="10.0" left="10.0" right="10.0" top="12.0" />
    </padding>
    <HBox alignment="CENTER_LEFT" spacing="10.0">
        <children>
            <Button onAction="#clickCargarCsvEstudiantes" styleClass="btn-primary" text="Cargar CSV" />
            <Button fx:id="btnDescartarCsv" disable="true" onAction="#clickDescartarCsv" styleClass="btn-secondary" text="Descartar vista previa CSV" />
            <Label fx:id="lblResumenCsv" style="-fx-text-fill: #64748b; -fx-font-size: 12px;" text="Estructura esperada CSV: identificacion, grado, apellido_1, apellido_2, nombre_1, nombre_2, genero" wrapText="true" />
        </children>
    </HBox>
    <HBox spacing="16.0" VBox.vgrow="ALWAYS">
        <VBox spacing="10.0" HBox.hgrow="ALWAYS">
            <children>
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <children>
                        <Label styleClass="label-filtro" text="Grado:" />
                        <ComboBox fx:id="cbFiltroGrado" prefWidth="110.0" styleClass="combo-filtro" />
                        <Label styleClass="label-filtro" text="Buscar:" />
                        <TextField fx:id="txtBuscarEstudiante" promptText="Buscar por nombre o identificacion..." styleClass="combo-filtro" HBox.hgrow="ALWAYS" />
                    </children>
                </HBox>
                <TableView fx:id="tblEstudiantes" minHeight="320.0" styleClass="tabla-datos" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colEstIdentificacion" prefWidth="120.0" text="Identificacion" />
                        <TableColumn fx:id="colEstGrado" prefWidth="70.0" text="Grado" />
                        <TableColumn fx:id="colEstApellido1" prefWidth="120.0" text="Apellido 1" />
                        <TableColumn fx:id="colEstApellido2" prefWidth="120.0" text="Apellido 2" />
                        <TableColumn fx:id="colEstNombre1" prefWidth="120.0" text="Nombre 1" />
                        <TableColumn fx:id="colEstNombre2" prefWidth="120.0" text="Nombre 2" />
                        <TableColumn fx:id="colEstGenero" prefWidth="80.0" text="Genero" />
                    </columns>
                    <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
                </TableView>
            </children>
        </VBox>
        <VBox maxWidth="360.0" minWidth="310.0" prefWidth="330.0" spacing="10.0" styleClass="containerInfo">
            <padding><Insets bottom="16.0" left="16.0" right="16.0" top="14.0" /></padding>
            <children>
                <VBox spacing="3.0">
                    <children>
                        <Label styleClass="subtitulo-seccion" text="Detalle y Edicion" />
                        <Label styleClass="descripcion-seccion" text="Selecciona un estudiante de la tabla para modificar sus datos." wrapText="true"><font><Font size="12.0" /></font></Label>
                    </children>
                </VBox>
                <Separator maxWidth="Infinity" />
                <VBox spacing="8.0" VBox.vgrow="ALWAYS">
                    <children>
                        <VBox spacing="3.0"><children><Label styleClass="label-filtro" text="Identificacion:" /><TextField fx:id="txtIdentificacion" promptText="Numero de documento" /></children></VBox>
                        <HBox spacing="10.0"><children>
                            <VBox spacing="3.0" HBox.hgrow="ALWAYS"><children><Label styleClass="label-filtro" text="Grado:" /><TextField fx:id="txtGrado" promptText="Ej: 11" /></children></VBox>
                            <VBox spacing="3.0" HBox.hgrow="ALWAYS"><children><Label styleClass="label-filtro" text="Genero:" /><TextField fx:id="txtGenero" promptText="M / F" /></children></VBox>
                        </children></HBox>
                        <HBox spacing="10.0"><children>
                            <VBox spacing="3.0" HBox.hgrow="ALWAYS"><children><Label styleClass="label-filtro" text="Primer Nombre:" /><TextField fx:id="txtNombre1" /></children></VBox>
                            <VBox spacing="3.0" HBox.hgrow="ALWAYS"><children><Label styleClass="label-filtro" text="Segundo Nombre:" /><TextField fx:id="txtNombre2" /></children></VBox>
                        </children></HBox>
                        <HBox spacing="10.0"><children>
                            <VBox spacing="3.0" HBox.hgrow="ALWAYS"><children><Label styleClass="label-filtro" text="Primer Apellido:" /><TextField fx:id="txtApellido1" /></children></VBox>
                            <VBox spacing="3.0" HBox.hgrow="ALWAYS"><children><Label styleClass="label-filtro" text="Segundo Apellido:" /><TextField fx:id="txtApellido2" /></children></VBox>
                        </children></HBox>
                    </children>
                </VBox>
                <Button fx:id="btnGuardarCambiosEstudiante" maxWidth="Infinity" onAction="#clickGuardarCambiosEstudiante" styleClass="btn-success" text="Guardar cambios"><VBox.margin><Insets top="6.0" /></VBox.margin></Button>
            </children>
        </VBox>
    </HBox>
</VBox>