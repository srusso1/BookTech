<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefWidth="440.0" spacing="15.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.Rectoria.EditarLibroController">
   <padding>
      <Insets bottom="20.0" left="25.0" right="25.0" top="20.0" />
   </padding>
   <children>
      <Label fx:id="lblLibro" styleClass="subtitulo-seccion" text="Modificar Libro">
         <font>
            <Font name="System Bold" size="18.0" />
         </font>
      </Label>
      <VBox spacing="8.0">
         <children>
            <HBox spacing="10.0">
               <children>
                  <Label text="Ubicación:">
                     <font>
                        <Font name="System Bold" size="14.0" />
                     </font>
                  </Label>
                  <Label fx:id="lblUbicacion" text="---">
                     <font>
                        <Font size="14.0" />
                     </font>
                  </Label>
               </children>
            </HBox>
            <HBox spacing="10.0">
               <children>
                  <Label text="Categoría:">
                     <font>
                        <Font name="System Bold" size="14.0" />
                     </font>
                  </Label>
                  <Label fx:id="lblCategoria" text="---">
                     <font>
                        <Font size="14.0" />
                     </font>
                  </Label>
               </children>
            </HBox>
            <HBox spacing="10.0">
               <children>
                  <Label text="Editorial:">
                     <font>
                        <Font name="System Bold" size="14.0" />
                     </font>
                  </Label>
                  <Label fx:id="lblEditorial" text="---">
                     <font>
                        <Font size="14.0" />
                     </font>
                  </Label>
               </children>
            </HBox>
            <HBox spacing="10.0">
               <children>
                  <Label text="Autor:">
                     <font>
                        <Font name="System Bold" size="14.0" />
                     </font>
                  </Label>
                  <Label fx:id="lblAutor" text="---">
                     <font>
                        <Font size="14.0" />
                     </font>
                  </Label>
               </children>
            </HBox>
            <HBox spacing="10.0">
               <children>
                  <Label text="Unidades:">
                     <font>
                        <Font name="System Bold" size="14.0" />
                     </font>
                  </Label>
                  <Label fx:id="lblUnidades" text="---">
                     <font>
                        <Font size="14.0" />
                     </font>
                  </Label>
               </children>
            </HBox>
         </children>
         <padding>
            <Insets bottom="5.0" top="5.0" />
         </padding>
      </VBox>
      <ComboBox fx:id="comboBoxModificar" maxWidth="Infinity" prefHeight="45.0" promptText="¿Qué desea modificar?" styleClass="combo-filtro" />
      <TextField fx:id="txtEditar" maxWidth="Infinity" prefHeight="45.0" promptText="Nuevo valor..." styleClass="combo-filtro">
         <font>
            <Font size="14.0" />
         </font>
      </TextField>
      <ComboBox fx:id="comboCategorias" maxWidth="Infinity" prefHeight="45.0" promptText="Elige una categoria" styleClass="combo-filtro" />
      <ComboBox fx:id="comboEditoriales" maxWidth="Infinity" prefHeight="45.0" promptText="Elige una editorial" styleClass="combo-filtro" />
      <HBox alignment="CENTER_RIGHT" spacing="12.0">
         <children>
             <Button onAction="#clickRegistrar" prefHeight="40.0" prefWidth="120.0" styleClass="btn-primary" text="Guardar">
               <font>
                  <Font size="14.0" />
               </font>
            </Button>
         </children>
         <VBox.margin>
            <Insets top="10.0" />
         </VBox.margin>
      </HBox>
   </children>
</VBox>
