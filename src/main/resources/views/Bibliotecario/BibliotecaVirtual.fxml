<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.ContextMenu?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="870.0" prefWidth="1180.0" stylesheets="@../../styles/Rectoria/EstadisticasStyle.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.Bibliotecario.BibliotecaVirtualController">
   <children>
      <VBox prefWidth="1180.0" spacing="20.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0.0">
         <padding>
            <Insets left="40.0" right="40.0" top="20.0" />
         </padding>
         <children>
            <Label text="Biblioteca virtual">
               <font>
                  <Font name="Roboto Medium" size="30" />
               </font>
            </Label>
            <Label text="Bienvenido al panel de la biblioteca virtual" textFill="#4b5563" wrapText="true">
               <font>
                  <Font name="Roboto Regular" size="16.0" />
               </font>
            </Label>
            <Separator prefHeight="20.0" prefWidth="1100.0" />
            <VBox spacing="25.0">
               <children>
                  <TextField fx:id="txtDocente" maxWidth="350.0" prefHeight="70.0" prefWidth="350.0" promptText="Nombre del docente">
                     <font>
                        <Font size="18.0" />
                     </font>
                     <contextMenu>
                        <ContextMenu>
                          <items>
                            <MenuItem mnemonicParsing="false" text="Unspecified Action" />
                          </items>
                        </ContextMenu>
                     </contextMenu>
                  </TextField>
                   <TextField fx:id="txtUso" maxWidth="350.0" prefHeight="70.0" prefWidth="350.0" promptText="Motivo de uso a la plataforma virtual">
                      <font>
                         <Font size="18.0" />
                      </font>
                   </TextField>
                  <ComboBox fx:id="comboGrados" prefHeight="44.0" prefWidth="202.0" promptText="Grado" />
                   <HBox spacing="20.0">
                      <children>
                         <VBox spacing="5.0">
                            <children>
                               <Label text="Hora de inicio">
                                  <font>
                                     <Font size="14.0" />
                                  </font>
                               </Label>
                               <Spinner fx:id="spinnerInicio" prefHeight="50.0" prefWidth="120.0" />
                            </children>
                         </VBox>
                         <VBox spacing="5.0">
                            <children>
                               <Label text="Hora de fin">
                                  <font>
                                     <Font size="14.0" />
                                  </font>
                               </Label>
                               <Spinner fx:id="spinnerFin" prefHeight="50.0" prefWidth="120.0" />
                            </children>
                         </VBox>
                         <VBox alignment="CENTER" spacing="5.0">
                            <children>
                               <Label fx:id="lblHorasCalculadas" text="Tiempo: 2h" textFill="#2e7d32" wrapText="true">
                                  <font>
                                     <Font name="Roboto Bold" size="16.0" />
                                  </font>
                               </Label>
                            </children>
                         </VBox>
                      </children>
                   </HBox>
                  <Button mnemonicParsing="false" onAction="#clickRegistrar" text="Registrar ">
                     <styleClass>
                        <String fx:value="btn" />
                        <String fx:value="btn-lg" />
                     </styleClass>
                  </Button>
               </children>
            </VBox>
         </children>
      </VBox>
   </children>
   <padding>
      <Insets bottom="30.0" top="30.0" />
   </padding>
</AnchorPane>
