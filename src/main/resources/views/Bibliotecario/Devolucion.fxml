<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="450.0" prefWidth="850.0" spacing="15.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.Bibliotecario.DevolucionController">
   <padding>
      <Insets bottom="20.0" left="25.0" right="25.0" top="20.0" />
   </padding>
   <children>
      <Label fx:id="lblLibro" styleClass="subtitulo-seccion" wrapText="true" />
      <Label fx:id="lbUnidadesPrestadas" styleClass="descripcion-seccion" text="Unidades prestadas: 0">
         <font>
            <Font size="14.0" />
         </font>
      </Label>
      <TableView fx:id="tabla" maxHeight="Infinity" maxWidth="Infinity" styleClass="tabla-datos" VBox.vgrow="ALWAYS">
        <columns>
          <TableColumn fx:id="tbEstudiante" prefWidth="150.0" text="Estudiante" />
          <TableColumn fx:id="tbGrado" prefWidth="80.0" text="Grado" />
          <TableColumn fx:id="tbPrestamo" prefWidth="110.0" text="F. Préstamo" />
          <TableColumn fx:id="tbLimite" prefWidth="110.0" text="F. Límite" />
          <TableColumn fx:id="tbEstado" prefWidth="100.0" text="Estado" />
        </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>
      <HBox alignment="CENTER_RIGHT" spacing="12.0">
         <children>
            <Button onAction="#clickDevolucion" prefHeight="40.0" prefWidth="170.0" styleClass="btn-primary" text="Registrar Devolución">
               <font>
                  <Font size="14.0" />
               </font>
            </Button>
            <Button onAction="#clickCancelar" prefHeight="40.0" prefWidth="100.0" styleClass="btn-secondary" text="Cancelar">
               <font>
                  <Font size="14.0" />
               </font>
            </Button>
         </children>
      </HBox>
   </children>
</VBox>
