<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.ContextMenu?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefWidth="420.0" spacing="15.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.Bibliotecario.PrestamoController">
    <padding>
        <Insets bottom="20.0" left="25.0" right="25.0" top="20.0" />
    </padding>

    <Label fx:id="lblLibro" styleClass="subtitulo-seccion" wrapText="true" />

    <TextField fx:id="txtEstudiante" maxWidth="Infinity" prefHeight="45.0" promptText="Nombre completo del estudiante" styleClass="combo-filtro">
      <font>
         <Font size="14.0" />
      </font>
      <contextMenu>
         <ContextMenu fx:id="sugerenciasMenu">
           <items>
             <MenuItem mnemonicParsing="false" text="Unspecified Action" />
           </items>
         </ContextMenu>
      </contextMenu>
    </TextField>

   <VBox fx:id="contenedorInfoEstudiante" alignment="CENTER_LEFT" spacing="6.0">
      <children>
         <HBox spacing="10.0">
            <children>
               <Label text="Identificación:">
                  <font>
                     <Font name="System Bold" size="14.0" />
                  </font>
               </Label>
               <Label fx:id="infoIdentificacion" text="---">
                  <font>
                     <Font size="14.0" />
                  </font>
               </Label>
            </children>
         </HBox>
         <HBox spacing="10.0">
            <children>
               <Label text="Grado:">
                  <font>
                     <Font name="System Bold" size="14.0" />
                  </font>
               </Label>
               <Label fx:id="infoGrado" text="---">
                  <font>
                     <Font size="14.0" />
                  </font>
               </Label>
            </children>
         </HBox>
      </children>
      <padding>
         <Insets bottom="5.0" top="5.0" />
      </padding>
   </VBox>

   <ComboBox fx:id="comboMotivosPrestamos" maxWidth="Infinity" prefHeight="45.0" promptText="Elige un motivo del préstamo" styleClass="combo-filtro" />
   
   <TextField fx:id="txtDocente" maxWidth="Infinity" prefHeight="45.0" promptText="Docente que lo envía (o 'No aplica')" styleClass="combo-filtro">
      <font>
         <Font size="14.0" />
      </font>
      <contextMenu>
         <ContextMenu fx:id="sugerenciasDocente">
           <items>
             <MenuItem mnemonicParsing="false" text="Unspecified Action" />
           </items>
         </ContextMenu>
      </contextMenu>
   </TextField>

    <DatePicker fx:id="dpFechaDevolucion" maxWidth="Infinity" prefHeight="45.0" promptText="Fecha de devolución" styleClass="date-picker-filtro" />
   
    <Label styleClass="descripcion-seccion" text="NOTA: Si ningún docente envía al estudiante, escriba 'No aplica'" wrapText="true">
      <font>
         <Font size="12.0" />
      </font>
   </Label>

    <HBox alignment="CENTER_RIGHT" spacing="12.0">
        <Button onAction="#clickRegistrar" prefHeight="40.0" prefWidth="110.0" styleClass="btn-primary" text="Registrar">
         <font>
            <Font size="14.0" />
         </font>
        </Button>
        <Button onAction="#clickCancelar" prefHeight="40.0" prefWidth="100.0" styleClass="btn-secondary" text="Cancelar">
         <font>
            <Font size="14.0" />
         </font>
        </Button>
      <VBox.margin>
         <Insets top="10.0" />
      </VBox.margin>
    </HBox>
</VBox>
