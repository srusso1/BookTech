<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.ContextMenu?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane stylesheets="@../../styles/Bibliotecario/PlataformaStyle.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.Bibliotecario.PlataformaVirtualController">
   <children>
      <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <content>
            <VBox spacing="20.0">
               <padding>
                  <Insets bottom="30.0" left="30.0" right="30.0" top="20.0" />
               </padding>
               <children>
                  <Label styleClass="titulo-seccion" text="Plataforma Virtual">
                     <font>
                        <Font name="Roboto Medium" size="28.0" />
                     </font>
                  </Label>
                  <Label styleClass="descripcion-seccion" text="Registro y control de uso de la sala de cómputo y plataforma virtual por docentes y grados." wrapText="true">
                     <font>
                        <Font name="Roboto Regular" size="15.0" />
                     </font>
                  </Label>
                  <Separator maxWidth="Infinity" />
                  <VBox maxWidth="450.0" spacing="20.0">
                     <children>
                        <TextField fx:id="txtDocente" maxWidth="Infinity" prefHeight="48.0" promptText="Nombre del docente responsable" styleClass="combo-filtro">
                           <font>
                              <Font size="15.0" />
                           </font>
                        </TextField>
                        <ComboBox fx:id="comboMotivoUso" maxWidth="Infinity" prefHeight="45.0" promptText="Motivo de uso de la sala" styleClass="combo-filtro" />
                        <ComboBox fx:id="comboGrados" maxWidth="Infinity" prefHeight="45.0" promptText="Grado" styleClass="combo-filtro" />
                        <HBox alignment="CENTER_LEFT" spacing="20.0">
                           <children>
                              <VBox spacing="5.0">
                                 <children>
                                    <Label text="Hora de inicio">
                                       <font>
                                          <Font size="14.0" />
                                       </font>
                                    </Label>
                                    <Spinner fx:id="spinnerInicio" editable="false" prefHeight="42.0" prefWidth="120.0" />
                                 </children>
                              </VBox>
                              <VBox spacing="5.0">
                                 <children>
                                    <Label text="Hora de fin">
                                       <font>
                                          <Font size="14.0" />
                                       </font>
                                    </Label>
                                    <Spinner fx:id="spinnerFin" editable="false" prefHeight="42.0" prefWidth="120.0" />
                                 </children>
                              </VBox>
                              <VBox alignment="CENTER_LEFT" spacing="5.0">
                                 <children>
                                    <Label fx:id="lblHorasCalculadas" styleClass="text-success" text="Tiempo: 0h" wrapText="true">
                                       <font>
                                          <Font name="Roboto Bold" size="15.0" />
                                       </font>
                                    </Label>
                                 </children>
                              </VBox>
                           </children>
                        </HBox>
                        <Button mnemonicParsing="false" onAction="#clickRegistrar" prefHeight="45.0" prefWidth="200.0" text="Registrar uso">
                           <styleClass>
                              <String fx:value="btn" />
                              <String fx:value="btn-primary" />
                              <String fx:value="btn-lg" />
                           </styleClass>
                           <VBox.margin>
                              <Insets top="10.0" />
                           </VBox.margin>
                        </Button>
                     </children>
                  </VBox>
               </children>
            </VBox>
         </content>
      </ScrollPane>
   </children>
</AnchorPane>
