<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.Bibliotecario.PrestamosActivosController">
   <children>
      <VBox spacing="18.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <padding>
            <Insets bottom="25.0" left="30.0" right="30.0" top="20.0" />
         </padding>
         <children>
            <Label styleClass="titulo-seccion" text="Préstamos Activos">
               <font>
                  <Font name="Roboto Medium" size="28.0" />
               </font>
            </Label>
            <Label styleClass="descripcion-seccion" text="Monitorea el estado, fechas límite y entregas de préstamos activos en tiempo real." wrapText="true">
               <font>
                  <Font name="Roboto Regular" size="15.0" />
               </font>
            </Label>
            <Separator maxWidth="Infinity" />
            <TableView fx:id="tabla" maxHeight="Infinity" maxWidth="Infinity" minHeight="280.0" styleClass="tabla-datos" VBox.vgrow="ALWAYS">
              <columns>
                <TableColumn fx:id="tbTituloLibro" prefWidth="150.0" text="Título" />
                <TableColumn fx:id="tbEstudiante" prefWidth="140.0" text="Estudiante" />
                  <TableColumn fx:id="tbGrado" prefWidth="80.0" text="Grado" />
                  <TableColumn fx:id="tbFPrestamo" prefWidth="110.0" text="F. Préstamo" />
                  <TableColumn fx:id="tbFLimite" prefWidth="110.0" text="F. Límite" />
                  <TableColumn fx:id="tbEstado" prefWidth="100.0" text="Estado" />
                  <TableColumn fx:id="tbMotivo" prefWidth="120.0" text="Motivo" />
                  <TableColumn fx:id="tbDocente" prefWidth="140.0" text="Docente" />
              </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>
            <VBox spacing="8.0">
               <children>
                  <Label styleClass="subtitulo-seccion" text="Leyenda de Estados">
                     <font>
                        <Font name="System Bold" size="16.0" />
                     </font>
                  </Label>
                  <Label styleClass="descripcion-seccion" text="• Estado Prestado: Dentro del plazo de devolución establecido." wrapText="true">
                     <font>
                        <Font size="14.0" />
                     </font>
                  </Label>
                  <Label styleClass="descripcion-seccion" text="• Estado Pendiente: Ha superado la fecha límite de devolución y se considera vencido." wrapText="true">
                     <font>
                        <Font size="14.0" />
                     </font>
                  </Label>
               </children>
               <VBox.margin>
                  <Insets top="10.0" />
               </VBox.margin>
            </VBox>
         </children>
      </VBox>
   </children>
</AnchorPane>
