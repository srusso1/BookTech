<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.Bibliotecario.PrestamosActivosController">
   <children>
      <VBox spacing="30" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0">
         <padding>
            <Insets left="40" right="40" top="20" />
         </padding>
         <children>
            <Label text="Prestamos activos">
               <font>
                  <Font name="Roboto Medium" size="30" />
               </font>
            </Label>
            <Label text="Bienvenido al panel de inicio. Aquí encontrarás un resumen general de la actividad de la biblioteca, incluyendo registros, préstamos y consultas recientes." textFill="#4b5563" wrapText="true">
               <font>
                  <Font name="Roboto Regular" size="16.0" />
               </font>
            </Label>
            <Separator prefHeight="20.0" prefWidth="1100.0" />
            <TableView fx:id="tabla" prefHeight="333.0" prefWidth="1100.0">
              <columns>
                <TableColumn fx:id="tbTituloLibro" prefWidth="75.0" text="Titulo" />
                <TableColumn fx:id="tbEstudiante" prefWidth="75.0" text="Estudiante" />
                  <TableColumn fx:id="tbGrado" prefWidth="75.0" text="Grado" />
                  <TableColumn fx:id="tbFPrestamo" prefWidth="75.0" text="F. Prestamo" />
                  <TableColumn fx:id="tbFLimite" prefWidth="75.0" text="F. Límite" />
                  <TableColumn fx:id="tbEstado" prefWidth="75.0" text="Estado" />
              </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>
            <VBox maxWidth="1000.0" prefHeight="200.0" prefWidth="100.0">
               <children>
                  <Label text="Estado: Prestado">
                     <font>
                        <Font name="System Bold" size="20.0" />
                     </font>
                  </Label>
                  <Label text="Este préstamo se encuentra dentro del plazo de devolución establecido, por lo que el estudiante aún tiene tiempo disponible para regresar el libro sin inconvenientes" textFill="#4b5563" wrapText="true">
                     <VBox.margin>
                        <Insets top="5.0" />
                     </VBox.margin>
                     <font>
                        <Font size="16.0" />
                     </font>
                  </Label>
                  <AnchorPane maxHeight="50.0" prefHeight="200.0" prefWidth="200.0" />
                  <Label text="Estado: Pendiente">
                     <font>
                        <Font name="System Bold" size="20.0" />
                     </font>
                  </Label>
                  <Label text="Este préstamo ha superado la fecha límite de devolución y el estudiante aún no ha realizado la entrega del libro, por lo que se considera como un préstamo vencido" textFill="#4b5563" wrapText="true">
                     <VBox.margin>
                        <Insets top="5.0" />
                     </VBox.margin>
                     <font>
                        <Font size="16.0" />
                     </font>
                  </Label>
               </children>
            </VBox>
         </children>
      </VBox>
   </children>
</AnchorPane>
